{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "separateMinorPatch": true,
  "flux": { "managerFilePatterns": ["/components/.+\\.yaml$/"] },
  "github-actions": { "enabled": false },
  "customDatasources": {
    "coder-stable": {
      "description": "GitHub releases 'latest' is Coder's stable pointer; the registry carries no channel info.",
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/coder/coder/releases/latest",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $substring(tag_name,1), \"releaseTimestamp\": published_at}],\"sourceUrl\":\"https://github.com/coder/coder\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/components/hcp-terraform-operator/configs/home/agentpool\\.yaml$/"],
      "matchStrings": [
        "image:\\s+\"hashicorp/tfc-agent:(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "depNameTemplate": "hashicorp/tfc-agent",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Engine image the operator hands every Dragonfly instance. Pinned to GHCR because upstream's default routes through an analytics layer that some DNS tools block, and consumed verbatim so it must carry a tag. A flat chart value rather than an image.repository/tag pair, so no built-in manager reads it.",
      "customType": "regex",
      "managerFilePatterns": ["/components/dragonfly-operator/controllers/base/helmrelease\\.yaml$/"],
      "matchStrings": [
        "dragonflyImage:\\s+\"?ghcr\\.io/dragonflydb/dragonfly:(?<currentValue>[^@\\s\"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ],
      "depNameTemplate": "ghcr.io/dragonflydb/dragonfly",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Coder chart tag follows the stable channel, not the registry tag list. Bare tag: this datasource cannot resolve a digest (coder/coder#13771).",
      "customType": "regex",
      "managerFilePatterns": ["/components/coder/controllers/base/ocirepository\\.yaml$/"],
      "matchStrings": ["tag:\\s+\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "coder-stable",
      "versioningTemplate": "semver-coerced",
      "datasourceTemplate": "custom.coder-stable"
    }
  ],
  "packageRules": [
    {
      "description": "Use semver-coerced versioning for all sources",
      "matchDatasources": ["docker", "helm", "git-refs", "github-tags"],
      "versioning": "semver-coerced",
      "pinDigests": true
    },
    {
      "description": "Automerge patch+minor for >=1.x",
      "matchDatasources": ["docker", "helm", "git-refs", "github-tags", "custom.coder-stable"],
      "matchCurrentVersion": "/^v?[1-9]/",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Ignore v-prefixed legacy tags in agentgateway chart registry",
      "matchPackagePatterns": ["cr\\.agentgateway\\.dev/charts/"],
      "allowedVersions": "/^[0-9]/"
    },
    {
      "description": "Automerge patch only for 0.x",
      "matchDatasources": ["docker", "helm", "git-refs", "github-tags"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "Coder: docker view lists every tag with no channel info, superseded by custom.coder-stable.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/coder/chart/coder"],
      "enabled": false
    },
    {
      "description": "Coder: a minor here is a stable-channel promotion, so merge it deliberately. Patches inherit the standard automerge.",
      "matchPackageNames": ["coder-stable"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
